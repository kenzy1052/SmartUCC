# Server port
PORT=3000

# Supabase (create a NEW project for CDE Exams, then run the SQL files in the database folder in order)
VITE_SUPABASE_URL=
# Browser-safe key: the "publishable" key (or legacy "anon" key). NEVER the service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only secrets (never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
